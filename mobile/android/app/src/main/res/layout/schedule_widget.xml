<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background"
    android:contentDescription="今日課表，點一下開啟 App">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="今日課表" android:textColor="@color/widget_text"
        android:textSize="17sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_body" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp"
        android:text="開啟 App 同步課表" android:textColor="@color/widget_text_secondary" android:textSize="14sp"
        android:ellipsize="end" />
</LinearLayout>
