<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background"
    android:contentDescription="今日課表，點一下開啟 App">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="今日課表" android:textColor="@color/widget_text"
        android:textSize="16sp" android:textStyle="bold" android:maxLines="1" />
    <TextView android:id="@+id/widget_body" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp"
        android:text="開啟 App 同步一次課表" android:textColor="@color/widget_text_secondary" android:textSize="14sp"
        android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/widget_attendance" android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1" android:orientation="horizontal" android:gravity="center"
            android:background="@drawable/widget_tile" android:contentDescription="快速點名">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_quick_attendance" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:text="快速點名" android:textColor="@color/widget_glyph"
                android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>

        <LinearLayout android:id="@+id/widget_library" android:layout_width="0dp" android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1" android:orientation="horizontal" android:gravity="center"
            android:background="@drawable/widget_tile" android:contentDescription="入館碼">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_quick_library" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:text="入館碼" android:textColor="@color/widget_glyph"
                android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
